# safe-streets settings. Copy to .env and fill in the first section; every
# other line shows its default, commented out.

# --- Required -------------------------------------------------------------

# The street's speed limit, in UNITS.
SPEED_LIMIT=
# The camera's time zone, an IANA name such as America/Los_Angeles or Europe/London.
TZ=
# How speeds are shown: mph or kmh. Speeds are stored in m/s either way.
# UNITS=mph

# --- Where footage comes from ---------------------------------------------

# folder: a directory of recorded segments named by their start time (the
# bundled recorder writes these, or point it at your NVR's export folder).
# protect: a UniFi Protect camera's continuous recording.
# SOURCE=folder
# SOURCE_DIR=/footage
# A strftime pattern for segment file names; local time in TZ unless it has %z.
# SOURCE_PATTERN=%Y%m%d-%H%M%S%z.mp4
# A segment modified within this many seconds is still being written.
# SOURCE_SETTLE_S=10

# UniFi Protect (SOURCE=protect only). Use a local, view-only account.
# PROTECT_HOST=
# PROTECT_PORT=443
# PROTECT_USERNAME=
# PROTECT_PASSWORD=
# The camera's name or id in Protect.
# PROTECT_CAMERA=
# How far behind now the recording can be exported.
# PROTECT_LAG_S=30
# PROTECT_TIMEOUT_SECONDS=60
# EXPORT_TIMEOUT_SECONDS=120
# LOGIN_RETRY_SECONDS=300

# --- Storage --------------------------------------------------------------

# DATA_DIR=./data
# MODELS_DIR=./models
# Clips, shots and thumbnails older than this are deleted.
# CLIP_RETENTION_DAYS=30
# Logs go to stdout; set a directory to also keep app.log, rotated daily.
# LOG_DIR=
# LOG_KEEP_DAYS=30

# --- Batches --------------------------------------------------------------

# BATCH_INTERVAL_SECONDS=60
# MAX_PER_RUN=10
# How far back to look for footage on a first start.
# LOOKBACK_HOURS=24
# Pacing, for a box shared with other work. Unset: never wait. Set (a
# percentage of CPU pressure, Linux only), batches wait while the box is
# busier than this, retrying every LOAD_RETRY_SECONDS, for at most MAX_SKIPS
# intervals. MAX_LOAD is the fallback where pressure can't be read.
# MAX_CPU_PRESSURE=
# MAX_LOAD=4.0
# MAX_SKIPS=30
# LOAD_RETRY_SECONDS=30
# /healthz says batch_stale when no batch has finished for this long.
# BATCH_STALE_SECONDS=1800
# CAMERA_CHECK_SECONDS=3600

# --- Clips ----------------------------------------------------------------

# Seconds added before and after each window of motion.
# CLIP_PAD_SECONDS=5
# CLIP_MAX_SECONDS=60

# --- Hooks ----------------------------------------------------------------

# Your own code, called after each batch with its new passes: comma-separated
# module:attr entry points, importable in the app's Python. Each is an object
# with `async batch_done(passes)` (or a callable returning one); see
# src/safe_streets/hooks.py for what a pass carries.
# HOOKS=
# Each hook gets this long a batch, then it's cancelled (and logged).
# HOOK_TIMEOUT_SECONDS=60

# --- The operator's dashboard (/operator) ---------------------------------

# password: a built-in password; the first start logs a one-time setup link
# (`safe-streets reset-password` makes a new one).
# none: no password, for trying it with `uv run` on one machine: it answers
# only requests from 127.0.0.1 that came through no proxy, and refuses to
# start with BASE_URL set. In Docker it always says 403 (your browser reaches
# the container from the bridge, not localhost): use password there.
# AUTH_MODE=password
# This app's address as people reach it, used in the setup link the log
# prints. An https address also marks the session cookie Secure.
# BASE_URL=https://traffic.example.org
# Behind a reverse proxy: the proxy's address (or * when only the proxy can
# reach the app, as in examples/compose.traefik.yml), so the app sees each
# visitor's address and https. Default: a proxy on this machine.
# FORWARDED_ALLOW_IPS=127.0.0.1
# Where the web server listens.
# WEB_HOST=0.0.0.0
# WEB_PORT=8080

# --- The public page ------------------------------------------------------

# Privacy (README, "Privacy by default"; read it before changing these):
# a time bucket is public once all of it is this many hours old, times are
# floored to this many minutes, and a bucket of fewer than PUBLIC_MIN_GROUP
# passes counts only in totals (no speed figure includes it).
# PUBLIC_DELAY_HOURS=24
# PUBLIC_TIME_BUCKET_MIN=15
# PUBLIC_MIN_GROUP=5


# --- Detection ------------------------------------------------------------

# cpu works anywhere; intel:gpu uses an Intel GPU through OpenVINO.
# YOLO_DEVICE=cpu
# The detector's lowest score for a vehicle. 0.25 finds more cars at dusk;
# raise it (0.35) if your view gives false passes.
# YOLO_CONFIDENCE=0.25
# GPU queue throttle for OpenVINO on an Intel GPU; empty switches it off.
# YOLO_GPU_THROTTLE=LOW
# Compiled-model cache; empty switches it off. Default: DATA_DIR/ov-cache.
# OV_CACHE_DIR=
# Run the detector only on samples where the road moved (off | shadow | on),
# and track only near them (off | on), from this long before to after.
# MOTION_GATE=off
# EPISODES=off
# TRACK_PAD_BEFORE_S=2.5
# TRACK_PAD_AFTER_S=2.5

# --- Speeds ---------------------------------------------------------------

# A track must cover this much road and time to be given a speed. These are
# in metres, seconds and mph whatever UNITS is.
# MIN_TRACK_M=4.0
# MIN_TRACK_S=0.5
# MAX_UNCERTAINTY_MPH=3.0
# PARKED_MPH=3.0
# Below this frame rate a pass is flagged low_fps.
# MIN_FPS=5.0

# --- Night (cars found by their lights) -----------------------------------

# off | log | on
# NIGHT_LIGHTS=on
# The near-lane line at night, image y at the left and right edges, used only
# when the calibration has none. Set it on the calibration page instead.
# NIGHT_LANE_Y0=
# NIGHT_LANE_Y1=
# NIGHT_CAR_COVER=0.6
# NIGHT_SPEED_COVER=0.8
# NIGHT_MAX_RESID_M=0.3
# NIGHT_CAR_MIN_MPH=7.0
# NIGHT_REFLECTION_M=1.0
# NIGHT_MIN_MPH=5.0
# NIGHT_MAX_MPH=60.0
# NIGHT_COMPANION_MIN_M=3.5
# NIGHT_COMPANION_MAX_M=7.0
# Join a car's light cut in two by something in front of the road.
# NIGHT_STITCH=off
# NIGHT_STITCH_GAP_S=0.3
# NIGHT_STITCH_M=1.0

# Set by the build.
# BUILD_SHA=dev

# --- Docker compose -------------------------------------------------------

# The host folder of recordings the app reads (mounted read-only at /footage;
# SOURCE_DIR is set to /footage for you).
# FOOTAGE_DIR=./footage
# The bundled recorder (examples/ffmpeg-segments.md): set
# COMPOSE_PROFILES=recorder and the camera's stream; it writes FOOTAGE_DIR.
# COMPOSE_PROFILES=recorder
# RTSP_URL=rtsp://user:password@camera.local:554/stream1
# RECORDER_KEEP_HOURS=48
# Seconds of silence from the camera before the recorder gives up and restarts.
# RECORDER_TIMEOUT_S=10
# Where the build gets the detector when models/rtmdet-tiny/ isn't there: a
# .tar.gz of rtmdet-tiny/, checked against the pinned sha256. The default is
# this repository's release asset:
# DETECTOR_URL=https://github.com/danhon/safe-streets/releases/download/detector-v1/rtmdet-tiny.tar.gz
